# Stripe ダッシュボード > 開発者 > APIキー
STRIPE_SECRET_KEY=your_stripe_secret_key

# Stripe CLI または Stripe ダッシュボードの Webhook 署名シークレット
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret

# 公開URL（末尾の / は不要）
APP_BASE_URL=https://isoya-commerce.com

# 任意: 決済完了注文を既存の受注システムへ転送するURL
# ORDER_WEBHOOK_URL=https://example.com/api/stripe-orders
# ORDER_WEBHOOK_SECRET=replace-with-a-long-random-value

PORT=3000
